# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key — server-side only, never expose to client
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ─── Site URL ─────────────────────────────────────────────────────────────────
# Used for canonical URLs, sitemap, OG tags, email verification links
NEXT_PUBLIC_SITE_URL=https://jamshidbilan.uz

# ─── Groq AI (translation feature) ───────────────────────────────────────────
GROQ_API_KEY=gsk_...

# ─── Telegram Bot (booking & webhook notifications) ───────────────────────────
TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_BOT_USERNAME=YourBotUsername
TELEGRAM_ADMIN_CHAT_ID=123456789
# Set a random secret and register it with Telegram's setWebhook API
TELEGRAM_WEBHOOK_SECRET=your-random-secret-here

# ─── Resend (email verification) ──────────────────────────────────────────────
RESEND_API_KEY=re_...
# Sender address — must be a verified domain in Resend for production
# RESEND_FROM=noreply@jamshidbilan.uz
